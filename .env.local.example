# =============================================
# Financials Dashboard — Environment Variables
# =============================================
# Copy this file to .env.local and fill in your values.
# On Vercel: add these in Project Settings > Environment Variables

# Required: Your Anthropic API key for Claude AI briefings
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override Yahoo Finance tickers for your funds
# The defaults work for most cases, but if data shows "unavailable"
# search Yahoo Finance for your fund and paste the exact ticker here.
#
# BGF World Financials Fund (default: 0P000062R2.L)
# Try searching: "BGF World Financials" on finance.yahoo.com
# Common formats: 0P000062R2.L (London), 0P000062R2.F (Frankfurt)
BGF_TICKER=0P000062R2.L

# iShares Fintech Active ETF (default: IACF)
# Verify at: finance.yahoo.com/quote/IACF
# If IACF doesn't work, try searching "iShares Fintech" on Yahoo Finance
FINTECH_TICKER=IACF
