# =============================================
# Financials Dashboard — Environment Variables
# =============================================
# Copy this file to .env.local for local dev.
# On Vercel: add these in Project Settings > Environment Variables.

# ── Required ──────────────────────────────────────────────────────────────

# Anthropic API key — for Claude AI morning briefings
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Financial Modeling Prep API key — for all market data (quotes, charts, news)
# Free tier: 250 calls/day — more than enough for this dashboard.
# Get yours at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your-fmp-api-key

# ── Optional overrides ────────────────────────────────────────────────────

# iShares Fintech Active ETF ticker on your exchange (default: IACF)
# Find on FMP: https://financialmodelingprep.com/financial-summary/IACF
FINTECH_TICKER=IACF

# If the iShares Fintech ETF is a UCITS fund (not US-listed), set its ISIN
# and leave FINTECH_TICKER unset — it will use BlackRock NAV data instead.
# FINTECH_ISIN=IE00XXXXXXXX

# BlackRock product URL slug for BGF World Financials NAV data.
# Default works for the A2 USD share class. To find the right slug:
# 1. Go to https://www.blackrock.com/uk/individual/products/
# 2. Search for your share class
# 3. The slug is the path after /products/ — e.g. "229115/bgf-world-financials-fund"
BGF_BLACKROCK_URL=229115/bgf-world-financials-fund
