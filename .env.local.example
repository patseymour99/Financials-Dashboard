# =============================================
# Financials Dashboard — Environment Variables
# =============================================
# Copy this file to .env.local for local dev.
# On Vercel: add in Project Settings > Environment Variables.

# ── Required ──────────────────────────────────────────────────────────────

# Anthropic API key — powers the AI Morning Briefing (Claude)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ──────────────────────────────────────────────────────────────

# BGF World Financials share class (BlackRock product ID).
# Default 229936 = A2 USD (ISIN LU0106831901).
# Other classes:  229935 = A2 EUR  |  229939 = D2 USD
BGF_PRODUCT_ID=229936

# Market data (quotes, history, news) is sourced from Yahoo Finance's
# public API — no API key required.
