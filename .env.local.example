# =============================================
# Financials Dashboard — Environment Variables
# =============================================
# Copy this file to .env.local for local dev.
# On Vercel: add these in Project Settings > Environment Variables.

# ── Required ──────────────────────────────────────────────────────────────

# Anthropic API key — for Claude AI morning briefings
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Financial Modeling Prep API key — for holdings and market indices
# Free tier (250 calls/day) is sufficient.
# Get yours at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your-fmp-api-key

# ── Optional overrides ────────────────────────────────────────────────────

# BGF World Financials share class (BlackRock product ID).
# Default 229936 = A2 USD (ISIN LU0106831901).
# Other classes:  229935 = A2 EUR (ISIN LU0171304719)
#                 229939 = D2 USD
BGF_PRODUCT_ID=229936

# iShares FinTech Active ETF is fixed at BlackRock product 329128 (BPAY,
# NYSE Arca) — no override needed unless BlackRock changes their product ID.
